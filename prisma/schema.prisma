generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MERCADOPAGO
  TRANSBANK
}

enum AttendanceCertificateType {
  LIVE_VIEWING
  EXAM
}

model User {
  id            String        @id @default(uuid())
  firebaseUid   String        @unique
  email         String        @unique
  firstName     String        @default("")
  lastName      String        @default("")
  rut           String?
  workplace     String        @default("")
  medicalArea   String        @default("")
  phoneNumber   String        @default("")
  city          String        @default("")
  photoUrl      String?
  emailVerified Boolean       @default(false)
  disabled      Boolean       @default(false)
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  purchases     Purchase[]
  attempts      ExamAttempt[]
  certificates  Certificate[]

  @@map("users")
}

model Course {
  id           String     @id @default(uuid())
  title        String
  description  String?
  thumbnailUrl String?
  priceClp     Int
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  videos       Video[]
  purchases    Purchase[]
  exams        Exam[]

  @@map("courses")
}

model Video {
  id           String   @id @default(uuid())
  courseId     String?
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  bunnyVideoId String?
  duration     Int?
  order        Int      @default(0)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("videos")
}

model Exam {
  id           String         @id @default(uuid())
  courseId     String?
  title        String
  passingScore Int            @default(60)
  published    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions    ExamQuestion[]
  attempts             ExamAttempt[]
  certificates         Certificate[]
  attendanceExamAttempts AttendanceExamAttempt[]

  @@map("exams")
}

model ExamQuestion {
  id      String       @id @default(uuid())
  examId  String
  text    String
  order   Int          @default(0)
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options ExamOption[]

  @@map("exam_questions")
}

model ExamOption {
  id         String       @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("exam_options")
}

model ExamAttempt {
  id          String   @id @default(uuid())
  userId      String
  examId      String
  score       Int
  passed      Boolean
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_attempts")
}

model Certificate {
  id              String   @id @default(uuid())
  userId          String
  examId          String
  certificateCode String   @unique
  issuedAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("certificates")
}

model Purchase {
  id                String          @id @default(uuid())
  userId            String
  courseId          String
  provider          PaymentProvider
  providerSessionId String          @unique
  providerPaymentId String?
  amountClp         Int
  status            PurchaseStatus  @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("purchases")
}

model AttendanceEligibility {
  id            String                  @id @default(uuid())
  email         String                  @unique
  firstName     String
  lastName      String
  watchedOver50 Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  certificates  AttendanceCertificate[]
  examAttempts  AttendanceExamAttempt[]

  @@map("attendance_eligibility")
}

model AttendanceExamAttempt {
  id            String                @id @default(uuid())
  eligibilityId String
  examId        String
  score         Int
  passed        Boolean
  submittedAt   DateTime              @default(now())
  eligibility   AttendanceEligibility @relation(fields: [eligibilityId], references: [id], onDelete: Cascade)
  exam          Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([eligibilityId, examId])
  @@map("attendance_exam_attempts")
}

model AttendanceCertificate {
  id              String                    @id @default(uuid())
  eligibilityId   String
  type            AttendanceCertificateType
  certificateCode String                    @unique
  issuedAt        DateTime                  @default(now())
  eligibility     AttendanceEligibility     @relation(fields: [eligibilityId], references: [id], onDelete: Cascade)

  @@unique([eligibilityId, type])
  @@map("attendance_certificates")
}
